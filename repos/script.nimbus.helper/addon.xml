<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.nimbus.helper" name="Nimbus Plus Helper" version="0.1.00" provider-name="Ivar Brandt, adamsbuilds">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.19.1"/>
        <import addon="script.module.pil" version="1.1.7"/>
    </requires>
    <extension point="xbmc.python.library" library="resources/lib/default.py"/>
    <extension point="xbmc.service" library="resources/lib/service.py" start="startup" />
    <extension point="xbmc.python.pluginsource" library="resources/lib/default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <reuselanguageinvoker>false</reuselanguageinvoker>
        <news />
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <forum />
        <source />
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
        <description lang="en_GB">Nimbus Plus Helper for the Nimbus Plus Skin. A fork of the Nimbus helper by Ivar Brandt.</description>
        <description lang="en_NZ">Nimbus Plus Helper for the Nimbus Plus Skin. A fork of the Nimbus helper by Ivar Brandt.</description>
        <description lang="en_US">Nimbus Plus Helper for the Nimbus Plus Skin. A fork of the Nimbus helper by Ivar Brandt.</description>
    </extension>
</addon>